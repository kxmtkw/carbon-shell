@import "common.rasi"

mainbox 
{
    enabled:                     true;
    spacing:                     @styleWidgetSpace;
	padding:                     @styleInnerPadding;
    border:                      @styleInnerBorderWidth;
    border-radius:               @styleInnerBorderRadius;
	border-color:                @styleInnerBorderColor;
    background-color:            @styleMainBoxColor;
    vertical-align:              0.5;
    orientation:                 vertical;
    children:                    [ "inputbar", "message", "entry" ];
}

inputbar {
    padding:                     15px;
    border-radius:               @styleWidgetBorderRadius;
    background-color:            @background;
    text-color:                  @onSurface;
    children:                    [ "dummy", "prompt", "dummy"];
}

dummy {
    background-color:            transparent;
}

prompt {
    background-color:            inherit;
    text-color:                  inherit;
}

message {
    enabled:                     true;
    margin:                      20px 30px;
    padding:                     10px;
    border-radius:               @styleWidgetBorderRadius;
    background-color:            @surfaceContainer;
    text-color:                  @onSurface;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
    padding:                     30px;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}


entry {
    enabled:                     true;
    expand:                      false;
    width:                       20%;
    margin:                      10px 30px;
    padding:                     12px 16px;
    border-radius:               @styleWidgetBorderRadius;
    background-color:            @surfaceContainer;
    text-color:                  @onSurface;
    cursor:                      text;
    placeholder:                 "";
    password:                    true;
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0;
}
