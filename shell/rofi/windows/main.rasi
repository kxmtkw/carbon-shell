@import "../Config/config.rasi"

configuration 
{
    modi:                       "window";

    window-match-fields: "title,class,role,name,desktop";
	window-command: "wmctrl -i -R {window}";
	window-format: " {c}  |  {t:50}";
	window-thumbnail: true;

    kb-element-next: "Tab";
    kb-element-prev: "Alt+Tab";    
}

@import "../Config/color.rasi"
@import "../Config/fonts.rasi"
@import "../Config/style.rasi"

* {
    font:                        @fontTextSmall;
}

window 
{    
    transparency:                "real";
    location:                    southwest;
    anchor:                      center;
    fullscreen:                  false;
    width:                       760px;
    height:                      520px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      10px;
    padding:                     @styleGaps;
    border-radius:               @styleOuterBorderRadius;
    cursor:                      "default";
    background-color:            @background;
}

mainbox 
{
    enabled:                     true;
    spacing:                     @styleWidgetSpace;
	padding:                     @styleInnerGaps;
    border:                      @styleInlineBorderWidth;
    border-radius:               @styleInnerBorderRadius;
	border-color:                @styleInlineBorderColor;
    background-color:            @styleBoxColor;
    vertical-align:              0.5;
    orientation:                 vertical;
    children:                    [ "listview" ];
}

listview 
{
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       false;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               false;
    
    spacing:                     10px;
    margin:                      0%;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            inherit;
    text-color:                  @onSurface;
    vertical-align:              0.5;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     15px;
    border:                      0px;
    border-radius:               0px;
    background-color:            inherit;
    text-color:                  inherit;
    orientation:                 horizontal;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}
element selected.normal {
	border:                      @styleSelectionBar; 
    border-color:                @styleSelectionColor;
}
element normal.active {
	border:                      @styleSelectionBar; 
    border-color:                @styleActiveColor;
}
element alternate.active {
	border:                      @styleSelectionBar; 
    border-color:                @styleActiveColor;
}
element selected.active {
	border:                      @styleSelectionBar; 
    border-color:                @styleActiveSelectionColor;
}
element-icon {
    background-color:            transparent;
    size:                        32px;
    cursor:                      inherit;
}
element-text {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
